# Create a free account at https://www.emailjs.com
# 1. Add an Email Service (e.g. Gmail) -> gives you VITE_EMAILJS_SERVICE_ID
# 2. Create a template for bookings   -> gives you VITE_EMAILJS_TEMPLATE_ID
#    Suggested template variables: guest_name, guest_email, guest_phone,
#    room_name, check_in, check_out, guests, total, notes, booking_ref
# 3. Create a second template for the contact form -> VITE_EMAILJS_CONTACT_TEMPLATE_ID
#    Suggested template variables: from_name, from_email, message
# 4. Copy your Public Key from Account > API Keys -> VITE_EMAILJS_PUBLIC_KEY
#
# Copy this file to ".env" and fill in the values below.
# Until these are set, bookings/messages are still saved (bookings persist
# in the browser via localStorage) but no email is sent.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# WhatsApp number in international format, without the leading + (e.g. 2348012345678)
VITE_WHATSAPP_NUMBER=
